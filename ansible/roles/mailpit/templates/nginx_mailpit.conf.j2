server {
    listen 80;
    server_name {{ mailpit_nginx_server_name }};

{% if mailpit_nginx_ssl %}
    location / {
        rewrite ^ https://$http_host$request_uri? permanent;
    }
    location /.well-known/ {
        alias /var/www/html/.well-known/;
    }
}

server {
    listen 443 ssl;
    server_name {{ mailpit_nginx_server_name }};

    ssl_certificate     /etc/letsencrypt/live/{{ mailpit_nginx_server_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ mailpit_nginx_server_name }}/privkey.pem;

{% endif %}
    location / {
        proxy_pass http://{{ mailpit_listen_http }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
